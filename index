    // --- POMODORO TIMER VIEW COMPONENT ---
    function PomodoroView({ tasks }) {
      const [mode, setMode] = useState('work'); // 'work' (25m), 'shortBreak' (5m), 'longBreak' (15m)
      const [timeLeft, setTimeLeft] = useState(25 * 60);
      const [isRunning, setIsRunning] = useState(false);
      const [selectedTaskId, setSelectedTaskId] = useState('');
      const [completedCycles, setCompletedCycles] = useState(0);

      const timerRef = useRef(null);

      const modeTimes = {
        work: 25 * 60,
        shortBreak: 5 * 60,
        longBreak: 15 * 60
      };

      const handleSwitchMode = (newMode) => {
        setMode(newMode);
        setIsRunning(false);
        setTimeLeft(modeTimes[newMode]);
      };

      useEffect(() => {
        if (isRunning) {
          timerRef.current = setInterval(() => {
            setTimeLeft(prev => {
              if (prev <= 1) {
                clearInterval(timerRef.current);
                setIsRunning(false);
                playNotificationSound();
                if (mode === 'work') {
                  setCompletedCycles(c => c + 1);
                }
                return 0;
              }
              return prev - 1;
            });
          }, 1000);
        } else {
          clearInterval(timerRef.current);
        }

        return () => clearInterval(timerRef.current);
      }, [isRunning, mode]);

      const formatTimer = (seconds) => {
        const mins = Math.floor(seconds / 60);
        const secs = seconds % 60;
        return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
      };

      return (
        <div className="max-w-xl mx-auto space-y-6">
          
          <div className="bg-white dark:bg-slate-800 rounded-3xl p-8 border border-slate-100 dark:border-slate-700/60 shadow-xl text-center space-y-6">
            <div className="inline-flex items-center gap-2 px-3 py-1 bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400 rounded-full text-xs font-semibold">
              <i className="fas fa-stopwatch"></i> Phương pháp Pomodoro
            </div>

            {/* Mode Selector Tabs */}
            <div className="flex items-center justify-center gap-2 bg-slate-100 dark:bg-slate-900 p-1.5 rounded-2xl text-xs font-semibold max-w-sm mx-auto">
              <button
                onClick={() => handleSwitchMode('work')}
                className={`flex-1 py-2 rounded-xl transition-all ${mode === 'work' ? 'bg-red-500 text-white shadow-md' : 'text-slate-500 hover:text-slate-800 dark:hover:text-white'}`}
              >
                Làm việc (25m)
              </button>
              <button
                onClick={() => handleSwitchMode('shortBreak')}
                className={`flex-1 py-2 rounded-xl transition-all ${mode === 'shortBreak' ? 'bg-emerald-500 text-white shadow-md' : 'text-slate-500 hover:text-slate-800 dark:hover:text-white'}`}
              >
                Nghỉ ngắn (5m)
              </button>
              <button
                onClick={() => handleSwitchMode('longBreak')}
                className={`flex-1 py-2 rounded-xl transition-all ${mode === 'longBreak' ? 'bg-blue-500 text-white shadow-md' : 'text-slate-500 hover:text-slate-800 dark:hover:text-white'}`}
              >
                Nghỉ dài (15m)
              </button>
            </div>

            {/* Timer Display */}
            <div className="py-6">
              <div className="text-7xl md:text-8xl font-black text-slate-800 dark:text-white tracking-tight font-mono">
                {formatTimer(timeLeft)}
              </div>
              <p className="text-xs text-slate-400 mt-2">
                {mode === 'work' ? 'Tập trung cao độ không xao nhãng' : 'Thư giãn mắt và cơ thể'}
              </p>
            </div>

            {/* Controls */}
            <div className="flex items-center justify-center gap-4">
              <button
                onClick={() => setIsRunning(!isRunning)}
                className={`w-36 py-3.5 rounded-2xl font-bold text-base text-white shadow-lg transition-transform hover:scale-105 active:scale-95 ${
                  isRunning ? 'bg-amber-500 hover:bg-amber-600 shadow-amber-500/20' : 'bg-red-500 hover:bg-red-600 shadow-red-500/20'
                }`}
              >
                <i className={`fas ${isRunning ? 'fa-pause' : 'fa-play'} mr-2`}></i>
                {isRunning ? 'Tạm dừng' : 'Bắt đầu'}
              </button>

              <button
                onClick={() => { setIsRunning(false); setTimeLeft(modeTimes[mode]); }}
                className="w-12 h-12 rounded-2xl bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 flex items-center justify-center transition-all"
                title="Đặt lại đồng hồ"
              >
                <i className="fas fa-rotate-right"></i>
              </button>
            </div>

            {/* Assigned Task Picker */}
            <div className="pt-4 border-t border-slate-100 dark:border-slate-700/60 text-left">
              <label className="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-2">
                Gắn phiên tập trung này với công việc:
              </label>
              <select
                value={selectedTaskId}
                onChange={(e) => setSelectedTaskId(e.target.value)}
                className="w-full bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-3 py-2 text-xs font-medium text-slate-700 dark:text-slate-200 focus:outline-none focus:border-red-500"
              >
                <option value="">-- Chọn công việc trong danh sách --</option>
                {tasks.filter(t => t.status !== 'completed').map(t => (
                  <option key={t.id} value={t.id}>{t.title}</option>
                ))}
              </select>
            </div>

            {/* Completed sessions counter */}
            <div className="flex items-center justify-between text-xs text-slate-400 bg-slate-50 dark:bg-slate-900/50 p-3 rounded-xl">
              <span>Chu kỳ Pomodoro đã xong hôm nay:</span>
              <span className="font-bold text-red-500">{completedCycles} phiên</span>
            </div>

          </div>

        </div>
      );
    }

    // --- ICS REMINDER CONFIG MODAL ---
    function ICSReminderModal({ task, onClose, onConfirm }) {
      const [reminderMins, setReminderMins] = useState(task.reminderOffset !== undefined ? task.reminderOffset : 30);

      return (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm animate-fadeIn">
          <div className="bg-white dark:bg-slate-800 rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-100 dark:border-slate-700 space-y-5">
            <div className="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-700">
              <div className="flex items-center gap-2.5">
                <div className="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-900/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-lg font-bold">
                  <i className="fas fa-calendar-plus"></i>
                </div>
                <div>
                  <h3 className="font-bold text-slate-800 dark:text-white text-base">Tạo tệp Lịch (.ics)</h3>
                  <p className="text-xs text-slate-400">Đặt giờ báo thức cho điện thoại</p>
                </div>
              </div>
              <button onClick={onClose} className="text-slate-400 hover:text-slate-600 dark:hover:text-white">
                <i className="fas fa-xmark text-lg"></i>
              </button>
            </div>

            <div>
              <p className="text-xs text-slate-600 dark:text-slate-300 mb-3 leading-relaxed">
                Công việc: <strong className="text-slate-800 dark:text-white">{task.title}</strong>
              </p>

              <label className="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-2">
                Chọn thời gian báo chuông nhắc nhở trước hạn:
              </label>
              <div className="space-y-2">
                {REMINDER_OPTIONS.map(opt => (
                  <label 
                    key={opt.value} 
                    className={`flex items-center justify-between p-3 rounded-xl border text-xs font-medium cursor-pointer transition-all ${
                      reminderMins === opt.value
                        ? 'bg-emerald-50 dark:bg-emerald-950/40 border-emerald-500 text-emerald-700 dark:text-emerald-300 font-bold'
                        : 'bg-slate-50 dark:bg-slate-900 border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100'
                    }`}
                  >
                    <div className="flex items-center gap-2">
                      <input
                        type="radio"
                        name="reminderChoice"
                        checked={reminderMins === opt.value}
                        onChange={() => setReminderMins(opt.value)}
                        className="text-emerald-600 focus:ring-emerald-500"
                      />
                      <span>{opt.label}</span>
                    </div>
                    <i className="fas fa-bell text-slate-400 text-xs"></i>
                  </label>
                ))}
              </div>
            </div>

            <div className="bg-slate-100 dark:bg-slate-900/60 p-3 rounded-xl text-[11px] text-slate-500 dark:text-slate-400 leading-normal flex items-start gap-2">
              <i className="fas fa-mobile-screen-button text-emerald-500 text-sm mt-0.5"></i>
              <span>Sau khi tải tệp <strong>.ics</strong>, chạm vào tệp trên điện thoại (iPhone hoặc Android) và chọn <strong>"Thêm vào Lịch"</strong> để đồng bộ báo thức.</span>
            </div>

            <div className="flex gap-3 pt-2">
              <button
                onClick={onClose}
                className="flex-1 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 font-medium text-xs hover:bg-slate-50 dark:hover:bg-slate-700"
              >
                Hủy
              </button>
              <button
                onClick={() => onConfirm(reminderMins)}
                className="flex-1 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs shadow-md shadow-emerald-500/20 flex items-center justify-center gap-2"
              >
                <i className="fas fa-download"></i> Tải file .ics
              </button>
            </div>
          </div>
        </div>
      );
    }

    // --- TASK CREATE / EDIT MODAL FORM ---
    function TaskFormModal({ initialData, onClose, onSave, onExportICS }) {
      const [title, setTitle] = useState(initialData?.title || '');
      const [description, setDescription] = useState(initialData?.description || '');
      
      // Setup datetime-local format YYYY-MM-DDTHH:mm
      const getInitialDeadline = () => {
        if (initialData?.deadline) {
          if (initialData.deadline.includes('T')) return initialData.deadline;
          return `${initialData.deadline}T09:00`;
        }
        return `${getTodayISO()}T17:00`;
      };

      const [deadline, setDeadline] = useState(getInitialDeadline());
      const [reminderOffset, setReminderOffset] = useState(initialData?.reminderOffset !== undefined ? initialData.reminderOffset : 30);
      const [priority, setPriority] = useState(initialData?.priority || 'medium');
      const [category, setCategory] = useState(initialData?.category || 'work');
      const [status, setStatus] = useState(initialData?.status || 'todo');
      const [subtasks, setSubtasks] = useState(initialData?.subtasks || []);
      const [newSubtaskTitle, setNewSubtaskTitle] = useState('');

      const handleSubmit = (e) => {
        e.preventDefault();
        if (!title.trim()) return;
        onSave({ title, description, deadline, reminderOffset, priority, category, status, subtasks });
      };

      const handleAddSubtask = () => {
        if (!newSubtaskTitle.trim()) return;
        setSubtasks([...subtasks, { id: Date.now().toString(), title: newSubtaskTitle.trim(), completed: false }]);
        setNewSubtaskTitle('');
      };

      const handleRemoveSubtask = (subId) => {
        setSubtasks(subtasks.filter(s => s.id !== subId));
      };

      return (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm overflow-y-auto">
          <div className="bg-white dark:bg-slate-800 rounded-3xl max-w-lg w-full p-6 md:p-8 shadow-2xl border border-slate-100 dark:border-slate-700 relative my-8 animate-fadeIn">
            
            {/* Header */}
            <div className="flex items-center justify-between mb-6 pb-4 border-b border-slate-100 dark:border-slate-700/60">
              <h3 className="text-xl font-bold text-slate-800 dark:text-white flex items-center gap-2">
                <i className="fas fa-pen-to-square text-blue-600"></i>
                {initialData ? 'Chỉnh sửa công việc' : 'Tạo công việc mới'}
              </h3>
              <button onClick={onClose} className="text-slate-400 hover:text-slate-600 dark:hover:text-white">
                <i className="fas fa-xmark text-lg"></i>
              </button>
            </div>

            <form onSubmit={handleSubmit} className="space-y-4">
              
              {/* Tiêu đề */}
              <div>
                <label className="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                  Tiêu đề công việc <span className="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  required
                  placeholder="Ví dụ: Nộp báo cáo tài chính tháng 11..."
                  value={title}
                  onChange={(e) => setTitle(e.target.value)}
                  className="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-800 dark:text-slate-100 focus:outline-none focus:border-blue-500"
                />
              </div>

              {/* Mô tả */}
              <div>
                <label className="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                  Mô tả chi tiết
                </label>
                <textarea
                  rows="3"
                  placeholder="Ghi chú chi tiết, đường dẫn, thông tin bổ sung..."
                  value={description}
                  onChange={(e) => setDescription(e.target.value)}
                  className="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-800 dark:text-slate-100 focus:outline-none focus:border-blue-500"
                ></textarea>
              </div>

              {/* Deadline & Reminder Choice */}
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label className="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                    Ngày & Giờ hết hạn (Deadline)
                  </label>
                  <input
                    type="datetime-local"
                    value={deadline}
                    onChange={(e) => setDeadline(e.target.value)}
                    className="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-800 dark:text-slate-100 focus:outline-none focus:border-blue-500"
                  />
                </div>

                <div>
                  <label className="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                    Báo trước cho Lịch ĐT
                  </label>
                  <select
                    value={reminderOffset}
                    onChange={(e) => setReminderOffset(Number(e.target.value))}
                    className="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-800 dark:text-slate-100 focus:outline-none focus:border-blue-500"
                  >
                    {REMINDER_OPTIONS.map(opt => (
                      <option key={opt.value} value={opt.value}>{opt.label}</option>
                    ))}
                  </select>
                </div>
              </div>

              {/* Status & Priority */}
              <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                  <label className="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                    Trạng thái
                  </label>
                  <select
                    value={status}
                    onChange={(e) => setStatus(e.target.value)}
                    className="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-800 dark:text-slate-100 focus:outline-none focus:border-blue-500"
                  >
                    <option value="todo">Cần làm</option>
                    <option value="in_progress">Đang làm</option>
                    <option value="completed">Hoàn thành</option>
                  </select>
                </div>

                <div>
                  <label className="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                    Mức độ ưu tiên
                  </label>
                  <select
                    value={priority}
                    onChange={(e) => setPriority(e.target.value)}
                    className="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-800 dark:text-slate-100 focus:outline-none focus:border-blue-500"
                  >
                    <option value="high">🔥 Cao</option>
                    <option value="medium">⚡ Trung bình</option>
                    <option value="low">🌱 Thấp</option>
                  </select>
                </div>

                <div>
                  <label className="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                    Danh mục
                  </label>
                  <select
                    value={category}
                    onChange={(e) => setCategory(e.target.value)}
                    className="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-800 dark:text-slate-100 focus:outline-none focus:border-blue-500"
                  >
                    <option value="work">💼 Công việc</option>
                    <option value="personal">👤 Cá nhân</option>
                    <option value="study">🎓 Học tập</option>
                    <option value="other">📌 Khác</option>
                  </select>
                </div>
              </div>

              {/* Subtasks Section */}
              <div className="pt-2">
                <label className="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                  Danh sách việc nhỏ (Subtasks)
                </label>
                <div className="flex gap-2 mb-2">
                  <input
                    type="text"
                    placeholder="Thêm mục con..."
                    value={newSubtaskTitle}
                    onChange={(e) => setNewSubtaskTitle(e.target.value)}
                    className="flex-1 px-3 py-1.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs"
                  />
                  <button
                    type="button"
                    onClick={handleAddSubtask}
                    className="px-3 py-1.5 bg-slate-200 dark:bg-slate-700 hover:bg-slate-300 text-xs font-medium rounded-xl"
                  >
                    Thêm
                  </button>
                </div>

                {subtasks.length > 0 && (
                  <div className="space-y-1 max-h-28 overflow-y-auto pr-1">
                    {subtasks.map((st) => (
                      <div key={st.id} className="flex items-center justify-between text-xs bg-slate-50 dark:bg-slate-900 p-2 rounded-lg">
                        <span className="truncate">{st.title}</span>
                        <button
                          type="button"
                          onClick={() => handleRemoveSubtask(st.id)}
                          className="text-red-500 hover:text-red-700 ml-2"
                        >
                          <i className="fas fa-trash-can text-xs"></i>
                        </button>
                      </div>
                    ))}
                  </div>
                )}
              </div>

              {/* Form Buttons */}
              <div className="flex items-center justify-between gap-3 pt-4 border-t border-slate-100 dark:border-slate-700/60">
                {initialData && (
                  <button
                    type="button"
                    onClick={() => onExportICS(initialData, reminderOffset)}
                    className="py-2.5 px-3 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-300 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300 text-xs font-semibold flex items-center gap-1.5"
                    title="Tải tệp .ics vào Lịch"
                  >
                    <i className="fas fa-calendar-plus text-sm"></i> Xuất .ics
                  </button>
                )}

                <div className="flex items-center gap-3 ml-auto">
                  <button
                    type="button"
                    onClick={onClose}
                    className="py-2.5 px-4 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 font-medium text-sm hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors"
                  >
                    Hủy
                  </button>
                  <button
                    type="submit"
                    className="py-2.5 px-4 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm shadow-md shadow-blue-500/20 transition-all hover:scale-105"
                  >
                    {initialData ? 'Cập nhật' : 'Tạo mới'}
                  </button>
                </div>
              </div>

            </form>
          </div>
        </div>
      );
    }

    // Render App
    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
</body>
</html>
