<body class="h-full bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 transition-colors duration-200">
  <div id="root" class="h-full"></div>

  <script type="text/babel">
    const { useState, useEffect, useMemo, useRef } = React;

    // --- Audio Sound Synthesizer for Pomodoro Beep ---
    const playNotificationSound = () => {
      try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        if (!AudioCtx) return;
        const ctx = new AudioCtx();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(587.33, ctx.currentTime); // D5
        osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.3); // A5
        gain.gain.setValueAtTime(0.2, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.6);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.6);
      } catch (e) {
        console.log('Audio notification fallback');
      }
    };

    // --- Helpers & Initial Data ---
    const CATEGORIES = {
      work: { name: 'Công việc', icon: 'fa-briefcase', color: 'bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300 border-blue-200 dark:border-blue-800' },
      personal: { name: 'Cá nhân', icon: 'fa-user', color: 'bg-purple-100 text-purple-700 dark:bg-purple-900/40 dark:text-purple-300 border-purple-200 dark:border-purple-800' },
      study: { name: 'Học tập', icon: 'fa-graduation-cap', color: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800' },
      other: { name: 'Khác', icon: 'fa-layer-group', color: 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 border-slate-200 dark:border-slate-700' }
    };

    const PRIORITIES = {
      high: { name: 'Cao', color: 'bg-red-500 text-white', badge: 'bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-300' },
      medium: { name: 'Trung bình', color: 'bg-amber-500 text-white', badge: 'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300' },
      low: { name: 'Thấp', color: 'bg-slate-400 text-white', badge: 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300' }
    };

    const STATUSES = {
      todo: { name: 'Cần làm', color: 'border-slate-300 dark:border-slate-700' },
      in_progress: { name: 'Đang làm', color: 'border-blue-500 text-blue-600' },
      completed: { name: 'Hoàn thành', color: 'border-emerald-500 text-emerald-600' }
    };

    const REMINDER_OPTIONS = [
      { label: 'Đúng giờ', value: 0 },
      { label: 'Trước 15 phút', value: 15 },
      { label: 'Trước 30 phút', value: 30 },
      { label: 'Trước 1 tiếng', value: 60 },
      { label: 'Trước 1 ngày', value: 1440 }
    ];

    // Helper to format date strings for display
    const formatDate = (dateStr) => {
      if (!dateStr) return '';
      const d = new Date(dateStr);
      if (isNaN(d.getTime())) return dateStr;
      
      const hasTime = dateStr.includes('T');
      if (hasTime) {
        return d.toLocaleString('vi-VN', { 
          day: '2-digit', 
          month: '2-digit', 
          year: 'numeric',
          hour: '2-digit',
          minute: '2-digit'
        });
      }
      return d.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
    };

    const getTodayISO = () => {
      const now = new Date();
      return now.toISOString().split('T')[0];
    };

    const getTomorrowISO = () => {
      const tomorrow = new Date();
      tomorrow.setDate(tomorrow.getDate() + 1);
      return tomorrow.toISOString().split('T')[0];
    };

    const getYesterdayISO = () => {
      const yesterday = new Date();
      yesterday.setDate(yesterday.getDate() - 1);
      return yesterday.toISOString().split('T')[0];
    };

    // --- ICS FILE GENERATOR (RFC 5545 COMPLIANT) ---
    const formatICSTime = (dateObj) => {
      const pad = (n) => String(n).padStart(2, '0');
      const year = dateObj.getUTCFullYear();
      const month = pad(dateObj.getUTCMonth() + 1);
      const day = pad(dateObj.getUTCDate());
      const hours = pad(dateObj.getUTCHours());
      const minutes = pad(dateObj.getUTCMinutes());
      const seconds = pad(dateObj.getUTCSeconds());
      return `${year}${month}${day}T${hours}${minutes}${seconds}Z`;
    };

    const escapeICS = (str) => {
      if (!str) return '';
      return str
        .replace(/\\/g, '\\\\')
        .replace(/;/g, '\\;')
        .replace(/,/g, '\\,')
        .replace(/\n/g, '\\n');
    };

    const buildSingleEventICS = (task, reminderMinutes = 30) => {
      let startDate;
      if (task.deadline) {
        if (task.deadline.includes('T')) {
          startDate = new Date(task.deadline);
        } else {
          startDate = new Date(`${task.deadline}T09:00:00`);
        }
      } else {
        startDate = new Date();
        startDate.setHours(9, 0, 0, 0);
      }
      
      if (isNaN(startDate.getTime())) {
        startDate = new Date();
      }

      const endDate = new Date(startDate.getTime() + 60 * 60 * 1000); // 1 hour duration
      const now = new Date();

      let descText = `Mức độ ưu tiên: ${PRIORITIES[task.priority]?.name || 'Trung bình'}\n`;
      descText += `Danh mục: ${CATEGORIES[task.category]?.name || 'Khác'}\n`;
      if (task.description) {
        descText += `\nMô tả: ${task.description}\n`;
      }
      if (task.subtasks && task.subtasks.length > 0) {
        descText += `\nViệc nhỏ cần làm:\n`;
        task.subtasks.forEach(s => {
          descText += `- [${s.completed ? 'x' : ' '}] ${s.title}\n`;
        });
      }
      descText += `\n--- Quản lý từ TaskFlow Việt ---`;

      const lines = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//TaskFlow Viet//Personal Task Manager//VI',
        'CALSCALE:GREGORIAN',
        'METHOD:PUBLISH',
        'BEGIN:VEVENT',
        `UID:taskflow-${task.id}-${Date.now()}@taskflow.local`,
        `DTSTAMP:${formatICSTime(now)}`,
        `DTSTART:${formatICSTime(startDate)}`,
        `DTEND:${formatICSTime(endDate)}`,
        `SUMMARY:${escapeICS(task.title)}`,
        `DESCRIPTION:${escapeICS(descText)}`,
        'STATUS:CONFIRMED',
      ];

      // Insert Phone Alarm Trigger (VALARM)
      if (reminderMinutes >= 0) {
        lines.push(
          'BEGIN:VALARM',
          'ACTION:DISPLAY',
          `DESCRIPTION:Nhắc nhở: ${escapeICS(task.title)}`,
          `TRIGGER:-PT${reminderMinutes}M`,
          'END:VALARM'
        );
      }

      lines.push('END:VEVENT', 'END:VCALENDAR');
      return lines.join('\r\n');
    };

    const buildBatchEventsICS = (taskList, reminderMinutes = 30) => {
      const now = new Date();
      const lines = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//TaskFlow Viet//Personal Task Manager//VI',
        'CALSCALE:GREGORIAN',
        'METHOD:PUBLISH'
      ];

      taskList.forEach(task => {
        let startDate;
        if (task.deadline) {
          if (task.deadline.includes('T')) {
            startDate = new Date(task.deadline);
          } else {
            startDate = new Date(`${task.deadline}T09:00:00`);
          }
        } else {
          startDate = new Date();
          startDate.setHours(9, 0, 0, 0);
        }
        
        if (isNaN(startDate.getTime())) startDate = new Date();
        const endDate = new Date(startDate.getTime() + 60 * 60 * 1000);

        let descText = `Ưu tiên: ${PRIORITIES[task.priority]?.name || 'Trung bình'}\n`;
        if (task.description) descText += `\nMô tả: ${task.description}\n`;
        if (task.subtasks && task.subtasks.length > 0) {
          descText += `\nViệc nhỏ:\n` + task.subtasks.map(s => `- [${s.completed ? 'x' : ' '}] ${s.title}`).join('\n') + '\n';
        }
        descText += `\n--- TaskFlow Việt ---`;

        lines.push(
          'BEGIN:VEVENT',
          `UID:taskflow-${task.id}-${Date.now()}@taskflow.local`,
          `DTSTAMP:${formatICSTime(now)}`,
          `DTSTART:${formatICSTime(startDate)}`,
          `DTEND:${formatICSTime(endDate)}`,
          `SUMMARY:${escapeICS(task.title)}`,
          `DESCRIPTION:${escapeICS(descText)}`,
          'STATUS:CONFIRMED'
        );

        if (reminderMinutes >= 0) {
          lines.push(
            'BEGIN:VALARM',
            'ACTION:DISPLAY',
            `DESCRIPTION:Nhắc nhở: ${escapeICS(task.title)}`,
            `TRIGGER:-PT${reminderMinutes}M`,
            'END:VALARM'
          );
        }

        lines.push('END:VEVENT');
      });

      lines.push('END:VCALENDAR');
      return lines.join('\r\n');
    };

    const triggerICSDownload = (filename, content) => {
      const blob = new Blob([content], { type: 'text/calendar;charset=utf-8' });
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.setAttribute('download', filename);
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      window.URL.revokeObjectURL(url);
    };

    // Initial Sample Tasks
    const INITIAL_TASKS = [
      {
        id: '1',
        title: 'Hoàn thành báo cáo tổng kết quý 4',
        description: 'Tổng hợp số liệu kinh doanh, đánh giá KPI phòng ban và chuẩn bị bài thuyết trình slide.',
        deadline: `${getTodayISO()}T16:30`,
        reminderOffset: 30,
        priority: 'high',
        category: 'work',
        status: 'in_progress',
        createdAt: new Date().toISOString(),
        subtasks: [
          { id: '101', title: 'Thu thập báo cáo từ đội Sales', completed: true },
          { id: '102', title: 'Vẽ biểu đồ tăng trưởng', completed: false }
        ]
      },
      {
        id: '2',
        title: 'Học 30 từ vựng Tiếng Anh Chuyên Ngành',
        description: 'Ôn tập chủ đề Technology & Business Management trên ứng dụng Anki.',
        deadline: `${getTomorrowISO()}T20:00`,
        reminderOffset: 15,
        priority: 'medium',
        category: 'study',
        status: 'todo',
        createdAt: new Date().toISOString(),
        subtasks: [
          { id: '201', title: 'Ôn 15 từ cũ', completed: false },
          { id: '202', title: 'Học 15 từ mới', completed: false }
        ]
      },
      {
        id: '3',
        title: 'Tập thể dục & Chạy bộ 5km',
        description: 'Duy trì thói quen sức khỏe tại công viên gần nhà.',
        deadline: `${getTodayISO()}T17:30`,
        reminderOffset: 15,
        priority: 'low',
        category: 'personal',
        status: 'completed',
        createdAt: new Date().toISOString(),
        subtasks: []
      },
      {
        id: '4',
        title: 'Đặt lịch bảo dưỡng xe máy định kỳ',
        description: 'Thay nhớt xe và kiểm tra phanh trước chuyến đi công tác xa.',
        deadline: `${getYesterdayISO()}T09:00`,
        reminderOffset: 60,
        priority: 'high',
        category: 'other',
        status: 'todo',
        createdAt: new Date().toISOString(),
        subtasks: []
      },
      {
        id: '5',
        title: 'Thiết kế giao diện Landing Page sản phẩm mới',
        description: 'Nghiên cứu UX/UI đối thủ, thiết kế wireframe trên Figma và xin phản hồi từ Product Manager.',
        deadline: `${getTomorrowISO()}T14:00`,
        reminderOffset: 30,
        priority: 'medium',
        category: 'work',
        status: 'in_progress',
        createdAt: new Date().toISOString(),
        subtasks: []
      }
    ];

    // --- MAIN APP COMPONENT ---
    function App() {
      // States
      const [tasks, setTasks] = useState(() => {
        const saved = localStorage.getItem('viet_task_manager_tasks_v2');
        return saved ? JSON.parse(saved) : INITIAL_TASKS;
      });

      const [darkMode, setDarkMode] = useState(() => {
        const saved = localStorage.getItem('viet_task_manager_theme');
        return saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
      });

      const [activeView, setActiveView] = useState('dashboard'); // 'dashboard', 'list', 'kanban', 'pomodoro'
      const [searchQuery, setSearchQuery] = useState('');
      const [filterCategory, setFilterCategory] = useState('all');
      const [filterPriority, setFilterPriority] = useState('all');
      const [filterTime, setFilterTime] = useState('all'); // 'all', 'today', 'upcoming', 'overdue'

      // Modal & Form state
      const [isModalOpen, setIsModalOpen] = useState(false);
      const [editingTask, setEditingTask] = useState(null);
      const [deleteModalId, setDeleteModalId] = useState(null);
      const [isMobileSidebarOpen, setIsMobileSidebarOpen] = useState(false);
      const [icsModalTask, setIcsModalTask] = useState(null); // Single task ICS reminder config modal

      // Toast Notification
      const [toast, setToast] = useState(null);

      const showToast = (message, type = 'info', duration = 4000) => {
        setToast({ message, type });
        setTimeout(() => setToast(null), duration);
      };

      // Sync tasks to LocalStorage
      useEffect(() => {
        localStorage.setItem('viet_task_manager_tasks_v2', JSON.stringify(tasks));
      }, [tasks]);

      // Sync Theme to HTML class
      useEffect(() => {
        if (darkMode) {
          document.documentElement.classList.add('dark');
          localStorage.setItem('viet_task_manager_theme', 'dark');
        } else {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('viet_task_manager_theme', 'light');
        }
      }, [darkMode]);

      // Task Actions
      const handleSaveTask = (taskData) => {
        if (editingTask) {
          setTasks(prev => prev.map(t => t.id === editingTask.id ? { ...t, ...taskData } : t));
          showToast('Đã cập nhật công việc thành công!', 'success');
        } else {
          const newTask = {
            ...taskData,
            id: Date.now().toString(),
            createdAt: new Date().toISOString(),
            status: taskData.status || 'todo',
            subtasks: taskData.subtasks || []
          };
          setTasks(prev => [newTask, ...prev]);
          showToast('Đã tạo công việc mới!', 'success');
        }
        setIsModalOpen(false);
        setEditingTask(null);
      };

      const handleToggleTaskStatus = (id) => {
        setTasks(prev => prev.map(t => {
          if (t.id === id) {
            const nextStatus = t.status === 'completed' ? 'todo' : 'completed';
            return { ...t, status: nextStatus };
          }
          return t;
        }));
      };

      const handleUpdateTaskStatus = (id, newStatus) => {
        setTasks(prev => prev.map(t => t.id === id ? { ...t, status: newStatus } : t));
        showToast(`Đã chuyển trạng thái sang "${STATUSES[newStatus].name}"`, 'info');
      };

      const handleDeleteTask = (id) => {
        setTasks(prev => prev.filter(t => t.id !== id));
        setDeleteModalId(null);
        showToast('Đã xóa công việc.', 'warning');
      };

      const handleToggleSubtask = (taskId, subtaskId) => {
        setTasks(prev => prev.map(t => {
          if (t.id === taskId) {
            const updatedSubtasks = (t.subtasks || []).map(s => 
              s.id === subtaskId ? { ...s, completed: !s.completed } : s
            );
            return { ...t, subtasks: updatedSubtasks };
          }
          return t;
        }));
      };

      // --- EXPORT TO ICS CALENDAR FUNCTIONS ---
      const handleExportSingleICS = (task, reminderMinutes = 30) => {
        const icsData = buildSingleEventICS(task, reminderMinutes);
        const cleanTitle = (task.title || 'cong_viec').replace(/[^a-zA-Z0-9_ -]/g, '').replace(/\s+/g, '_');
        triggerICSDownload(`TaskFlow_${cleanTitle}.ics`, icsData);
        showToast('Đã tải tệp .ics! Hãy chạm vào tệp vừa tải để lưu vào Lịch điện thoại (iPhone/Android).', 'success', 6000);
      };

      const handleExportAllIncompleteICS = () => {
        const incompleteTasks = tasks.filter(t => t.status !== 'completed');
        if (incompleteTasks.length === 0) {
          showToast('Không có công việc chưa hoàn thành nào để xuất lịch!', 'warning');
          return;
        }
        const batchICS = buildBatchEventsICS(incompleteTasks, 30);
        triggerICSDownload(`TaskFlow_TatCaCongViec_${getTodayISO()}.ics`, batchICS);
        showToast(`Đã xuất ${incompleteTasks.length} công việc sang tệp .ics! Mở tệp để đồng bộ điện thoại.`, 'success', 6000);
      };

      // Reset Data to sample
      const handleResetData = () => {
        setTasks(INITIAL_TASKS);
        showToast('Đã khôi phục dữ liệu mẫu ban đầu!', 'info');
      };

      // Export JSON
      const handleExportJSON = () => {
        const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(tasks, null, 2));
        const downloadAnchor = document.createElement('a');
        downloadAnchor.setAttribute("href", dataStr);
        downloadAnchor.setAttribute("download", `taskflow_backup_${getTodayISO()}.json`);
        document.body.appendChild(downloadAnchor);
        downloadAnchor.click();
        downloadAnchor.remove();
        showToast('Đã tải xuống tệp dữ liệu dự phòng!', 'success');
      };

      // Import JSON
      const handleImportJSON = (e) => {
        const fileReader = new FileReader();
        if (e.target.files && e.target.files[0]) {
          fileReader.readAsText(e.target.files[0], "UTF-8");
          fileReader.onload = (event) => {
            try {
              const parsed = JSON.parse(event.target.result);
              if (Array.isArray(parsed)) {
                setTasks(parsed);
                showToast('Đã nhập dữ liệu công việc thành công!', 'success');
              } else {
                showToast('Định dạng tệp không hợp lệ!', 'error');
              }
            } catch (err) {
              showToast('Lỗi khi đọc tệp dữ liệu!', 'error');
            }
          };
        }
      };

      // Filtered Tasks logic
      const filteredTasks = useMemo(() => {
        const todayStr = getTodayISO();

        return tasks.filter(task => {
          // Keyword search
          if (searchQuery.trim() !== '') {
            const query = searchQuery.toLowerCase();
            const matchTitle = task.title.toLowerCase().includes(query);
            const matchDesc = (task.description || '').toLowerCase().includes(query);
            if (!matchTitle && !matchDesc) return false;
          }

          // Category filter
          if (filterCategory !== 'all' && task.category !== filterCategory) return false;

          // Priority filter
          if (filterPriority !== 'all' && task.priority !== filterPriority) return false;

          // Time filter
          const taskDateOnly = task.deadline ? task.deadline.split('T')[0] : '';

          if (filterTime === 'today') {
            if (taskDateOnly !== todayStr) return false;
          } else if (filterTime === 'upcoming') {
            if (!taskDateOnly || taskDateOnly <= todayStr) return false;
          } else if (filterTime === 'overdue') {
            if (!taskDateOnly || taskDateOnly >= todayStr || task.status === 'completed') return false;
          }

          return true;
        });
      }, [tasks, searchQuery, filterCategory, filterPriority, filterTime]);

      // Computed Stats for Dashboard
      const stats = useMemo(() => {
        const total = tasks.length;
        const completed = tasks.filter(t => t.status === 'completed').length;
        const inProgress = tasks.filter(t => t.status === 'in_progress').length;
        const todo = tasks.filter(t => t.status === 'todo').length;
        const todayStr = getTodayISO();
        
        const overdue = tasks.filter(t => {
          const taskDateOnly = t.deadline ? t.deadline.split('T')[0] : '';
          return taskDateOnly && taskDateOnly < todayStr && t.status !== 'completed';
        }).length;

        const percent = total > 0 ? Math.round((completed / total) * 100) : 0;

        return { total, completed, inProgress, todo, overdue, percent };
      }, [tasks]);

      return (
        <div className="flex h-screen overflow-hidden bg-slate-50 dark:bg-slate-900">
          
          {/* TOAST NOTIFICATION */}
          {toast && (
            <div className={`fixed top-5 right-5 z-50 flex items-center gap-3 px-4 py-3 rounded-2xl shadow-xl text-white font-medium text-sm transition-all duration-300 transform translate-y-0 max-w-md ${
              toast.type === 'success' ? 'bg-emerald-600' :
              toast.type === 'warning' ? 'bg-amber-600' :
              toast.type === 'error' ? 'bg-red-600' : 'bg-blue-600'
            }`}>
              <i className={`fas ${
                toast.type === 'success' ? 'fa-circle-check' :
                toast.type === 'warning' ? 'fa-triangle-exclamation' :
